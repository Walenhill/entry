# Database configuration
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=booking_db
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# Master password for admin login (initial password, will be hashed and stored in DB)
MASTER_PASSWORD=change_this_master_password

# Set to true if the app is behind a trusted reverse proxy that strips client X-Forwarded-For headers
TRUST_X_FORWARDED_FOR=false

# Application settings
APP_ENV=development
APP_DEBUG=true
